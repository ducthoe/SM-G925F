+/* Native packed operations are safe once inexact is already sticky and the
+ * guest uses round-to-nearest. Accept only zero/normal inputs and results above
+ * FLT_MIN: exceptional values, tiny results and other rounding modes continue
+ * through SoftFloat, preserving ARM exception flags and signed-zero handling.
+ * Limit this path to AdvSIMD-sized vectors; leave SVE's larger loops alone.
+ */
+static bool host_vec_f32(void *vd, const void *vn, const void *vm,
+                         float_status *stat, intptr_t size, unsigned operation)
+{
+#ifdef __x86_64__
+    __m128i mask, aa, bb;
+    __m128 a, b, result;
+    const __m128i magnitude = _mm_set1_epi32(0x7fffffff);
+    const __m128i min_normal = _mm_set1_epi32(0x00800000);
+    const __m128i infinity = _mm_set1_epi32(0x7f800000);
+    const __m128i zero = _mm_setzero_si128();
+    unsigned active;
+
+    if ((size != 8 && size != 16) ||
+        !(get_float_exception_flags(stat) & float_flag_inexact) ||
+        get_float_rounding_mode(stat) != float_round_nearest_even) {
+        return false;
+    }
+    active = size == 16 ? 15 : 3;
+    a = _mm_castsi128_ps(size == 16 ? _mm_loadu_si128(vn) : _mm_loadl_epi64(vn));
+    b = _mm_castsi128_ps(size == 16 ? _mm_loadu_si128(vm) : _mm_loadl_epi64(vm));
+    aa = _mm_and_si128(_mm_castps_si128(a), magnitude);
+    bb = _mm_and_si128(_mm_castps_si128(b), magnitude);
+    mask = _mm_and_si128(
+        _mm_or_si128(_mm_cmpeq_epi32(aa, zero),
+                     _mm_cmpgt_epi32(aa, _mm_set1_epi32(0x007fffff))),
+        _mm_cmpgt_epi32(infinity, aa));
+    mask = _mm_and_si128(mask, _mm_and_si128(
+        _mm_or_si128(_mm_cmpeq_epi32(bb, zero),
+                     _mm_cmpgt_epi32(bb, _mm_set1_epi32(0x007fffff))),
+        _mm_cmpgt_epi32(infinity, bb)));
+    if ((_mm_movemask_ps(_mm_castsi128_ps(mask)) & active) != active) {
+        return false;
+    }
+    switch (operation) {
+    case 0:
+        result = _mm_add_ps(a, b);
+        break;
+    case 1:
+        result = _mm_sub_ps(a, b);
+        break;
+    case 2:
+        result = _mm_mul_ps(a, b);
+        break;
+#ifdef __FMA__
+    case 3:
+    case 4:
+    {
+        __m128 c = _mm_castsi128_ps(size == 16 ? _mm_loadu_si128(vd) :
+                                               _mm_loadl_epi64(vd));
+        __m128i cc = _mm_and_si128(_mm_castps_si128(c), magnitude);
+
+        mask = _mm_and_si128(
+            _mm_or_si128(_mm_cmpeq_epi32(cc, zero),
+                         _mm_cmpgt_epi32(cc, _mm_set1_epi32(0x007fffff))),
+            _mm_cmpgt_epi32(infinity, cc));
+        if ((_mm_movemask_ps(_mm_castsi128_ps(mask)) & active) != active) {
+            return false;
+        }
+        result = operation == 3 ? _mm_fmadd_ps(a, b, c) : _mm_fnmadd_ps(a, b, c);
+        break;
+    }
+#endif
+    default:
+        return false;
+    }
+    aa = _mm_and_si128(_mm_castps_si128(result), magnitude);
+    mask = _mm_and_si128(_mm_cmpgt_epi32(aa, min_normal),
+                         _mm_cmpgt_epi32(infinity, aa));
+    if ((_mm_movemask_ps(_mm_castsi128_ps(mask)) & active) != active) {
+        return false;
+    }
+    if (size == 16) {
+        _mm_storeu_si128(vd, _mm_castps_si128(result));
+    } else {
+        _mm_storel_epi64(vd, _mm_castps_si128(result));
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
+#define DO_HOST_3OP_F32(NAME, FUNC, OP)                                    \
+void HELPER(NAME)(void *vd, void *vn, void *vm,                            \
+                  float_status *stat, uint32_t desc)                       \
+{                                                                          \
+    intptr_t i, size = simd_oprsz(desc);                                  \
+    float32 *d = vd, *n = vn, *m = vm;                                    \
+    if (!host_vec_f32(vd, vn, vm, stat, size, OP)) {                       \
+        for (i = 0; i < size / sizeof(float32); i++) {                    \
+            d[i] = FUNC(n[i], m[i], stat);                               \
+        }                                                                  \
+    }                                                                      \
+    clear_tail(d, size, simd_maxsz(desc));                                \
+}
