+static Object *gd_phone_display(void)
+{
+    if (g_strcmp0(g_getenv("G925_PHONE_NAV"), "1") != 0) {
+        return NULL;
+    }
+    return object_resolve_path_type("", "s6-vfb-display", NULL);
+}
+
+static bool gd_phone_landscape(void)
+{
+    Object *display = gd_phone_display();
+
+    return display && object_property_get_bool(display, "landscape", NULL);
+}
+
+static void gd_phone_rotate(VirtualConsole *vc)
+{
+    Object *display = gd_phone_display();
+    GtkDisplayState *s = vc->s;
+    double scale = MIN(vc->gfx.scale_x, vc->gfx.scale_y);
+
+    if (!display) {
+        return;
+    }
+    object_property_set_bool(display, "landscape", !gd_phone_landscape(),
+                              &error_abort);
+    if (!s->full_screen) {
+        GdkMonitor *monitor = gdk_display_get_monitor_at_window(
+            gtk_widget_get_display(s->window),
+            gtk_widget_get_window(s->window));
+        GdkRectangle work;
+        DisplaySurface *surface = qemu_console_surface(vc->gfx.dcl.con);
+        int chrome = MAX(0, gtk_widget_get_allocated_height(s->vbox) -
+                            gtk_widget_get_allocated_height(vc->gfx.drawing_area));
+        int width = surface_width(surface);
+        int height = surface_height(surface);
+
+        gdk_monitor_get_workarea(monitor, &work);
+        scale = MIN(scale, MIN((double)MAX(180, work.width - 80) / width,
+                               (double)MAX(180, work.height - chrome - 80) / height));
+        gtk_window_resize(GTK_WINDOW(s->window), MAX(1, (int)(width * scale)),
+                          MAX(1, (int)(height * scale) + chrome));
+    }
+}
