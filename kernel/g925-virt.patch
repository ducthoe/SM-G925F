+	avail = min_t(unsigned long, avail, PIPE_WRITE_PAGES * PAGE_SIZE - offset);
+	count = DIV_ROUND_UP(offset + avail, PAGE_SIZE);
+	pinned = goldfish_pin_upload_pages(address & PAGE_MASK, count, pages);
+	if (pinned <= 0)
