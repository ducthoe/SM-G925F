+static int goldfish_pin_upload_pages(unsigned long address, int count,
+                                    struct page **pages)
+{
+	struct mm_struct *mm = current->mm;
+	int pinned = 0, slow;
+
+	if (!fast_upload_pins)
+		return get_user_pages_fast(address, count, 0, pages);
+	down_read(&mm->mmap_sem);
+	while (pinned < count && !fatal_signal_pending(current)) {
+		struct vm_area_struct *vma = find_vma(mm, address);
+		pgd_t *pgd;
+		pud_t *pud;
+		pmd_t *pmd;
+		pte_t *table, *cursor;
+		spinlock_t *lock;
+		unsigned long end;
+
+		if (!vma || address < vma->vm_start || !(vma->vm_flags & VM_READ) ||
+		    (vma->vm_flags & (VM_IO | VM_PFNMAP | VM_HUGETLB)))
+			break;
+		pgd = pgd_offset(mm, address);
+		if (pgd_none(*pgd) || pgd_bad(*pgd))
+			break;
+		pud = pud_offset(pgd, address);
+		if (pud_none(*pud) || pud_bad(*pud))
+			break;
+		pmd = pmd_offset(pud, address);
+		if (pmd_none(*pmd) || pmd_trans_huge(*pmd) || pmd_bad(*pmd))
+			break;
+		end = min(vma->vm_end, (address & PMD_MASK) + PMD_SIZE);
+		table = pte_offset_map_lock(mm, pmd, address, &lock);
+		cursor = table;
+		while (pinned < count && address < end) {
+			pte_t entry = *cursor;
+			struct page *page;
+
+			if (!pte_valid_user(entry) || !pte_young(entry) || pte_special(entry))
+				break;
+			page = vm_normal_page(vma, address, entry);
