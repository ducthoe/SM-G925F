+static int goldfish_pipe_write_vector(struct goldfish_pipe *pipe,
+                                     unsigned long address, unsigned long avail)
+{
+	struct goldfish_pipe_dev *dev = pipe->dev;
+	struct page *pages[PIPE_WRITE_PAGES];
+	struct write_segment segments[PIPE_WRITE_PAGES];
+	unsigned long offset = address & (PAGE_SIZE - 1);
+	unsigned long remaining, irq_flags;
+	int count, pinned, i, status;
